# ──────────────────────────────────────────────────────────────────────────
# My Stem Cell Guide — environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# Database (MongoDB Atlas or local) — PRD §12
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/mystemcellguide?retryWrites=true&w=majority"

# Auth.js / NextAuth — Stage 2
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (credentials + Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email — SMTP via our own mailbox (owner lead notifications + verification and
# password-reset emails). For Gmail / Google Workspace, SMTP_PASS is a 16-char
# Google App Password (requires 2-Step Verification on the account — the normal
# login password is rejected with a 535). Leave all of these unset in dev to
# log emails to the server console instead of sending.
SMTP_HOST="smtp.gmail.com"
# 465 = implicit TLS. If the host blocks 465 egress (ETIMEDOUT / ESOCKET),
# switch to 587, which STARTTLSes with the same credentials.
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Must match the authenticated account (or a verified "send mail as" alias) —
# Gmail silently rewrites the From header otherwise.
EMAIL_FROM=""
# Comma-separated owner addresses copied on every lead notification. Falls back
# to admin Settings → contact email when empty.
LEADS_NOTIFY_EMAIL=""

# Media provider — Cloudinary (or swap for UploadThing/S3 in lib/media.ts)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Maps (clinic location maps + geocode helper)
NEXT_PUBLIC_MAPS_API_KEY=""

# Rate limiting — Upstash Redis (public forms: review, lead, contact)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Captcha — hCaptcha or Cloudflare Turnstile
CAPTCHA_PROVIDER="turnstile"          # "turnstile" (default) or "hcaptcha"
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# Analytics (optional — primarily configured in admin Settings → analytics).
# These env vars are build-time fallbacks if Settings are unset.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Vercel Cron — shared secret for /api/cron/* (Stage 9.1).
# Generate: `openssl rand -base64 32`. Required in production; optional in dev.
CRON_SECRET=""

# Public site URL (canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────────────────────
# SEO team dashboard (/seoteam → publishes to public /blog)
# ──────────────────────────────────────────────────────────────────────────
# Single shared password the SEO team uses to sign in at /seoteam.
SEO_DASHBOARD_PASSWORD=""
# Secret used to sign the dashboard session cookie (HMAC-SHA256).
# Generate: `openssl rand -base64 32`
SESSION_SECRET=""
# Inline blog images + cover uploads reuse the Cloudinary vars above
# (CLOUDINARY_*). If those are unset, the editor falls back to pasting image URLs.

# ──────────────────────────────────────────────────────────────────────────
# AnalyticsHub dashboard (/analyticshub) — see ANALYTICSHUB_SETUP.md
# ──────────────────────────────────────────────────────────────────────────
# Root secret. ONE key derives (HKDF) both the AES-256-GCM data key and the
# session-cookie HMAC key. Generate: `openssl rand -base64 32` (paste the raw
# 44-char output, no quotes). Changing it later orphans everything stored.
ANALYTICSHUB_SECRET_KEY=""
# Shared Google OAuth app for GA4 + Search Console "Sign in with Google".
# Optional: if unset, the dashboard only offers the service-account path.
# Redirect URI to register: <origin>/api/analyticshub/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# (No KV vars needed — the hub stores its config in MongoDB via MONGODB_URI.)
# (Meta + Google Ads credentials are entered in the dashboard, never here.)
